# Copiar como .env y completar con la configuración web de Firebase.
# Después ejecutar: npm run env  (genera los archivos de src/environments)
# Nunca subir el .env con valores reales.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# true para conectar la app a los emuladores locales (solo desarrollo)
FIREBASE_USE_EMULATORS=false
