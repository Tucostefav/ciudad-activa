# Copiar este archivo como .env y completar los valores.
# Nunca subir el .env con claves reales.

# --- Firebase (configuración de la app web/móvil) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Supabase (cliente de la app) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Solo para las funciones de supabase/functions (no van en la app) ---
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_SERVICE_ACCOUNT=
